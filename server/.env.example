# Pearl Guide Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pearl_guide?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Optional: AI Provider (e.g. Gemini / OpenAI for dynamic itinerary synthesis in Phase 2)
AI_API_KEY=your_gemini_or_openai_api_key_here

# Optional: Payment Gateway (Stripe or PayHere Sandbox for Phase 2)
PAYMENT_GATEWAY_API_KEY=your_payment_api_key_here
